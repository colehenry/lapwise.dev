# lapwise.dev Backend - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================================================
# Database Configuration
# ============================================================================
# Primary database URL (used in production)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# Optional: Local development database
LOCAL_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/f1_analytics

# Optional: Development/staging database
DEV_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# ============================================================================
# Application Settings
# ============================================================================
# Enable debug mode (True for development, False for production)
DEBUG=False

# Secret key for session encryption and security (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-change-this-in-production

# CORS allowed origins (comma-separated list of frontend URLs)
# For production, replace with your actual frontend URL
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public frontend traffic key. This is shipped to browsers as NEXT_PUBLIC_API_KEY
# and must not be treated as a secret. Use rate limits, auth, caching, and WAF/CDN
# controls for real abuse protection.
LAPWISE_API_KEY=your-api-key-change-this

# Shared rate-limit storage for production. Use Redis or another shared backend
# so limits are enforced across all API instances.
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/0

# Comma-separated direct proxy hosts that may set X-Forwarded-For/X-Real-IP.
# Leave empty unless your platform/load balancer has a known direct peer IP.
# Use "loopback" for local reverse proxies only.
# Use "*" only after confirming spoofed X-Forwarded-For values are not recorded.
TRUSTED_PROXY_HOSTS=

# Frontend URL used for auth redirects and secure cookie decisions.
FRONTEND_URL=http://localhost:3000

# ============================================================================
# Error Monitoring (Sentry)
# ============================================================================
# DSN from your Sentry Python project. Leave unset to disable monitoring.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ============================================================================
# FastF1 Configuration
# ============================================================================
# Directory for caching F1 telemetry data (can be several GB)
FASTF1_CACHE_DIR=./cache
