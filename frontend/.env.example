# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public traffic key sent to the backend as X-API-Key.
# This is visible in browser bundles and is not a secret.
NEXT_PUBLIC_API_KEY=your-public-traffic-key

# Optional long-running Clutch origin. In production this should be the public
# URL of the Railway service running this Next.js app, without a trailing path.
NEXT_PUBLIC_CLUTCH_API_URL=https://your-clutch-service.up.railway.app

# Server-only AI settings for Next.js API routes. All model calls use
# OpenRouter; paste the key into .env.local, never this example file.
OPEN_ROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Optional comma-separated browser origins allowed to call a separate Clutch
# service. Defaults include lapwise.dev, www.lapwise.dev, and localhost:3000.
CLUTCH_ALLOWED_ORIGINS=https://lapwise.dev,https://www.lapwise.dev
# Optional low-cost model used only by npm run smoke:openrouter.
OPENROUTER_SMOKE_MODEL=deepseek/deepseek-v4-flash-0731
AI_TOTAL_QUERY_LIMIT=3
AI_IP_RATE_LIMIT_PER_MINUTE=6
AI_DB_QUERY_TIMEOUT_MS=8000
AI_HISTORY_MESSAGE_LIMIT=12
AI_HISTORY_CHARACTER_LIMIT=24000
AI_RESPONSE_CACHE_TTL_HOURS=168
AI_RESPONSE_CACHE_VERSION=clutch-v3

# Server-only database connections for AI.
# AI_DB_URL should use a read-only database role with access only to approved F1 tables.
AI_DB_URL=postgresql://readonly_user:password@host/database?sslmode=require
NEON_DATABASE_URL=postgresql://app_user:password@host/database?sslmode=require
